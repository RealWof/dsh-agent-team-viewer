{
  "name": "dsh-agent-team-viewer",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "DeepSeek Harness plugin: a read-only viewer of the Agent Team board. Kanban columns follow task status, a card opens a block inspector, the subagent tree is grouped by status with run time, background time, tokens and agent-hours in the same order the totals row uses, and each agent's background processes are counted in its row and listed in a foldable, scrollable dialog block.",
  "author": "RealWof",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealWof/dsh-agent-team-viewer.git"
  },
  "homepage": "https://github.com/RealWof/dsh-agent-team-viewer#readme",
  "bugs": {
    "url": "https://github.com/RealWof/dsh-agent-team-viewer/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.ru.md",
    "docs/DETAIL.zh.md",
    "docs/INSTALL.md",
    "docs/preview.svg",
    "assets",
    "screenshots.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "subagents",
    "kanban",
    "observability",
    "cost"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-client.js",
    "check": "node scripts/build-client.js && node scripts/check-i18n.mjs && node scripts/smoke.mjs && node scripts/check-pack.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "smoke": "node scripts/smoke.mjs",
    "i18n": "node scripts/check-i18n.mjs",
    "icon": "node scripts/make-icon.mjs",
    "set-version": "node scripts/set-version.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "prepublishOnly": "npm run check"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
